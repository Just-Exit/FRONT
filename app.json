{
  "expo": {
    "name": "Local Demo",
    "slug": "local-demo",
    "scheme": "localdemo",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.choihajin.localdemo"
    },
    "android": {
      "package": "com.choihajin.localdemo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "옷장에 등록할 사진을 선택할 수 있도록 사진 접근을 허용해 주세요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5768219f-cb03-4e64-af0a-b4f3b7a8fabe"
      }
    },
    "owner": "summer_jin"
  }
}
